default_platform(:ios)

API_KEY_PATH = File.expand_path("../fastlane/AuthKey/AuthKey_NT9BFWFD26.p8", __dir__)
PRIVACY_URL  = "https://ffwyhsfz64-maker.github.io/moni-legal/rentavoz-privacy-policy.html"

def api_key
  app_store_connect_api_key(
    key_id:       "NT9BFWFD26",
    issuer_id:    "8b526b55-ffff-4241-b436-aac23ad2afe0",
    key_filepath: API_KEY_PATH,
    duration:     1200,
    in_house:     false
  )
end

platform :ios do

  # ── App Store 제출 ────────────────────────────────────────
  desc "빌드 + 메타데이터 + 스크린샷 + 심사 제출 (원클릭)"
  lane :release do
    key = api_key

    get_certificates(api_key: key)
    get_provisioning_profile(
      api_key:        key,
      app_identifier: "com.onuri.rentavoz",
      provisioning_name: "RentaVoz AppStore Distribution"
    )

    # Flutter 빌드 (아카이브)
    sh("cd .. && flutter build ipa --release --dart-define=GOOGLE_API_KEY=AIzaSyDVIvgmjznkZs2wZ4dtYczdX5ikCCKbZ8A 2>&1")

    # xcodebuild export (flutter가 자동 export 실패하므로 수동)
    sh("cd .. && xcodebuild -exportArchive \
      -archivePath build/ios/archive/Runner.xcarchive \
      -exportPath build/ios/ipa \
      -exportOptionsPlist fastlane/ExportOptions.plist 2>&1")

    upload_to_app_store(
      api_key:            key,
      ipa:                "./build/ios/ipa/rentavoz.ipa",
      metadata_path:      "./fastlane/metadata",
      screenshots_path:   "./fastlane/screenshots",
      skip_screenshots:   false,
      skip_metadata:      false,
      privacy_url: {
        "es-MX" => PRIVACY_URL,
        "en-US" => PRIVACY_URL,
        "ja"    => PRIVACY_URL,
        "ko"    => PRIVACY_URL,
      },
      support_url: {
        "es-MX" => PRIVACY_URL,
        "en-US" => PRIVACY_URL,
        "ja"    => PRIVACY_URL,
        "ko"    => PRIVACY_URL,
      },
      copyright:        "© 2026 GWIHO JIN",
      primary_category: "LIFESTYLE",
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        first_name:    "Gwiho",
        last_name:     "Jin",
        phone_number:  "+82 10-5099-7697",
        email_address: "jgh1775@naver.com",
        demo_user:     "",
        demo_password: "",
        notes:         "This is a rental review app for Mexico. Users can write and read reviews about rental properties. Location permission is used only when selecting an address on the map."
      },
      submission_information: {
        add_id_info_uses_idfa:                  false,
        export_compliance_uses_encryption:       false,
        export_compliance_is_exempt:             true,
        content_rights_has_rights:               true,
        content_rights_contains_third_party_content: false
      }
    )
  end

  # ── TestFlight 업로드 (내부 테스트용) ────────────────────
  desc "빌드 + TestFlight 업로드 (심사 제출 없음)"
  lane :beta do
    key = api_key

    get_certificates(api_key: key)
    get_provisioning_profile(
      api_key:           key,
      app_identifier:    "com.onuri.rentavoz",
      provisioning_name: "RentaVoz AppStore Distribution"
    )

    sh("cd .. && flutter build ipa --release --dart-define=GOOGLE_API_KEY=AIzaSyDVIvgmjznkZs2wZ4dtYczdX5ikCCKbZ8A 2>&1")

    sh("cd .. && xcodebuild -exportArchive \
      -archivePath build/ios/archive/Runner.xcarchive \
      -exportPath build/ios/ipa \
      -exportOptionsPlist fastlane/ExportOptions.plist 2>&1")

    upload_to_testflight(
      api_key:                           key,
      ipa:                               File.expand_path("../build/ios/ipa/rentavoz.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )
  end

  # ── TestFlight 업로드만 (빌드 완료된 IPA) ─────────────────
  desc "이미 빌드된 IPA를 TestFlight에만 업로드"
  lane :upload_beta do
    key = api_key
    upload_to_testflight(
      api_key:                           key,
      ipa:                               File.expand_path("../build/ios/ipa/rentavoz.ipa", __dir__),
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )
  end

  # ── IPA만 업로드 (빌드 완료된 경우) ──────────────────────
  desc "기존 빌드된 IPA를 메타데이터와 함께 업로드 + 제출"
  lane :upload do |options|
    key = api_key
    upload_to_app_store(
      api_key:          key,
      ipa:              options[:ipa] || "./build/ios/ipa/rentavoz.ipa",
      skip_binary_upload: options[:skip_ipa] || false,
      metadata_path:    "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_screenshots: false,
      skip_metadata:    false,
      privacy_url: {
        "es-MX" => PRIVACY_URL,
        "en-US" => PRIVACY_URL,
        "ja"    => PRIVACY_URL,
        "ko"    => PRIVACY_URL,
      },
      support_url: {
        "es-MX" => PRIVACY_URL,
        "en-US" => PRIVACY_URL,
        "ja"    => PRIVACY_URL,
        "ko"    => PRIVACY_URL,
      },
      copyright:        "© 2026 GWIHO JIN",
      primary_category: "LIFESTYLE",
      submit_for_review:   true,
      automatic_release:   true,
      force:               true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa:                  false,
        export_compliance_uses_encryption:       false,
        export_compliance_is_exempt:             true,
        content_rights_has_rights:               true,
        content_rights_contains_third_party_content: false
      }
    )
  end

end
