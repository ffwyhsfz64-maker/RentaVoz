rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── 리뷰 사진: photos/{reviewId}/{파일명} ─────────────────────
    match /photos/{reviewId}/{fileName} {
      // 누구나 읽기 가능 (피드·상세 화면 표시)
      allow read: if true;

      // 로그인한 사용자만 업로드 가능
      // 파일 크기 10MB 이하, 이미지 파일만 허용
      allow write: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // 삭제: 로그인 사용자만 (본인 확인은 Firestore 규칙에서 처리)
      allow delete: if request.auth != null;
    }

    // ── 납부 증명서: comprobantes/{reviewId}.{ext} ────────────────
    match /comprobantes/{fileName} {
      // 누구나 읽기 가능 (검증 배지 표시용)
      allow read: if true;

      // 로그인한 사용자만 업로드 가능
      // 파일 크기 20MB 이하, 이미지 또는 PDF
      allow write: if request.auth != null
        && request.resource.size <= 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf');

      allow delete: if request.auth != null;
    }

    // ── 그 외 경로 접근 차단 ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
